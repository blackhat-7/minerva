# Local speech server for Minerva (OpenAI-compatible STT + TTS on CPU; the GPU stays free for the LLM).
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
LOG_LEVEL=info
ENABLE_UI=false
WHISPER__INFERENCE_DEVICE=cpu
WHISPER__COMPUTE_TYPE=int8
WHISPER__CPU_THREADS=8
STT_MODEL_TTL=-1
TTS_MODEL_TTL=-1
PRELOAD_MODELS=["istupakov/parakeet-tdt-0.6b-v2-onnx","speaches-ai/Kokoro-82M-v1.0-ONNX"]
