[Unit]
Description=Minerva — learning app (API + web UI on :8765)
After=network.target speaches.service

[Service]
WorkingDirectory=%h/Documents/projects/minerva/backend
# `claude` (Claude Code CLI) and `uv` must be on PATH; Minerva runs `claude -p` with your own login.
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:%h/.nix-profile/bin:/usr/local/bin:/usr/bin
ExecStart=uv run --frozen minerva
Restart=on-failure

[Install]
WantedBy=default.target
